{
  "name": "kixiki-c001",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:owner": "node --check public/control/app.js && node --check public/dono/app.js && node --check public/kixiki-public.js && node --check public/kixiki-analytics.js && node --test tests/kixiki-owner-model.test.mjs tests/kixiki-owner-handler.test.mjs tests/kixiki-public-model.test.mjs tests/kixiki-public-handler.test.mjs tests/kixiki-public-client.test.mjs tests/kixiki-events-handler.test.mjs tests/kixiki-metrics-handler.test.mjs tests/owner-panel-static.test.mjs tests/closing-sprint-static.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "netlify:build": "npm run test:owner"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13",
    "@netlify/functions": "5.3.0",
    "@netlify/identity": "1.2.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "C001 Kixiki Lanches"
}
